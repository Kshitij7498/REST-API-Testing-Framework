{
  "info": {
    "_postman_id": "f2a6a7a4-56de-4c1f-b118-4f8d7e7b7d61",
    "name": "REST API Testing Framework",
    "description": "Automated CRUD, authentication, validation, response-code, and JSON schema checks against the included local sample API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check - public",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Health response schema is valid', () => { pm.expect(body).to.have.property('status', 'ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET items - authentication required",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing auth returns 401', () => pm.response.to.have.status(401));",
              "pm.test('Error response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET items - invalid token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer wrong-token",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid token returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Forbidden error shape', () => pm.expect(pm.response.json().error).to.eql('Forbidden'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET items - list and schema validation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('List schema and data types', () => { pm.expect(body.data).to.be.an('array'); pm.expect(body.count).to.be.a('number'); pm.expect(body.count).to.eql(body.data.length); if (body.data.length) { pm.expect(body.data[0].id).to.be.a('number'); pm.expect(body.data[0].name).to.be.a('string'); pm.expect(body.data[0]).to.have.property('description'); } });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST item - reject missing name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"Missing required name\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing name returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Validation error is explained', () => pm.expect(pm.response.json().message).to.include('name'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST item - reject invalid name type",
