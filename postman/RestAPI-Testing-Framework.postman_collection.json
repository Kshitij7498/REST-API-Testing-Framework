    {
      "name": "POST item - create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Framework test item\", \"description\": \"Created by Postman collection\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Created item schema and values', () => { pm.expect(body.data.id).to.be.a('number'); pm.expect(body.data.name).to.eql('Framework test item'); pm.expect(body.data.description).to.eql('Created by Postman collection'); pm.expect(body.message).to.eql('Item created'); });",
              "pm.environment.set('itemId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET item - read created item",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Read returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Returned item matches created item', () => { pm.expect(body.data.id).to.eql(Number(pm.environment.get('itemId'))); pm.expect(body.data.name).to.eql('Framework test item'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT item - update",
      "request": {
        "method": "PUT",
