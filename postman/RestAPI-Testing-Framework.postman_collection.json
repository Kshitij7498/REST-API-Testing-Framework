        ],
        "url": "{{baseUrl}}/api/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Updated framework item\", \"description\": \"Updated by automated test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "event": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Updated fields are persisted', () => { pm.expect(body.data.name).to.eql('Updated framework item'); pm.expect(body.data.description).to.eql('Updated by automated test'); pm.expect(body.data.id).to.eql(Number(pm.environment.get('itemId'))); });"
            ]
          }
        }
      ]
